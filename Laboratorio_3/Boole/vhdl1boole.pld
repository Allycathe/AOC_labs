library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_ARITH.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;

entity Sin_Titulo is
	Port (
		inicio: in std_logic;
		ck: in std_logic;
		x: in std_logic;
		z: out std_logic
		);
end Sin_Titulo;

architecture behavioral of Sin_Titulo is

type nombres_estados is (Q0, Q1, Q2, Q3, Q4, Q5, Q6, Q7, Q8, Q9);
signal estado: nombres_estados;
signal entrada_aux: std_logic_vector (0 downto 0);

begin

entrada_aux<=x

process(inicio, ck)
begin
if inicio='1' then
	estado<=Q0;
elsif ck='1' and ck'event then
	case estado is
		when Q0 =>
			case entrada_aux is
				when '0' => estado<=Q0;
				when '1' => estado<=Q1;
				when others => estado<=Q0;
			end case;
		when Q1 =>
			case entrada_aux is
				when '0' => estado<=Q2;
				when '1' => estado<=Q1;
				when others => estado<=Q0;
			end case;
		when Q2 =>
			case entrada_aux is
				when '0' => estado<=Q0;
				when '1' => estado<=Q3;
				when others => estado<=Q0;
			end case;
		when Q3 =>
			case entrada_aux is
				when '0' => estado<=Q4;
				when '1' => estado<=Q1;
				when others => estado<=Q0;
			end case;
		when Q4 =>
			case entrada_aux is
				when '0' => estado<=Q0;
				when '1' => estado<=Q5;
				when others => estado<=Q0;
			end case;
		when Q5 =>
			case entrada_aux is
				when '0' => estado<=Q4;
				when '1' => estado<=Q6;
				when others => estado<=Q0;
			end case;
		when Q6 =>
			case entrada_aux is
				when '0' => estado<=Q2;
				when '1' => estado<=Q7;
				when others => estado<=Q0;
			end case;
		when Q7 =>
			case entrada_aux is
				when '0' => estado<=Q8;
				when '1' => estado<=Q1;
				when others => estado<=Q0;
			end case;
		when Q8 =>
			case entrada_aux is
				when '0' => estado<=Q0;
				when '1' => estado<=Q9;
				when others => estado<=Q0;
			end case;
		when Q9 =>
			case entrada_aux is
				when '0' => estado<=Q0;
				when '1' => estado<=Q1;
				when others => estado<=Q0;
			end case;
		when others => estado<=Q0;
	end case;
end if;
end process;

process(estado)
begin
case estado is
	when Q0 =>
		z<='0';
	when Q1 =>
		z<='0';
	when Q2 =>
		z<='0';
	when Q3 =>
		z<='0';
	when Q4 =>
		z<='0';
	when Q5 =>
		z<='0';
	when Q6 =>
		z<='0';
	when Q7 =>
		z<='0';
	when Q8 =>
		z<='0';
	when Q9 =>
		z<='1';
end case;
end process;

end behavioral;
